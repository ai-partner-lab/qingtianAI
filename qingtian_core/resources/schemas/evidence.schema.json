{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qingtian-ai:schema:evidence:v1",
  "title": "Qingtian Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "subject_type", "subject_id", "result", "metadata", "observed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^evidence_[A-Za-z0-9_-]+$"},
    "subject_type": {"enum": ["task", "session", "run", "release", "artifact"]},
    "subject_id": {
      "type": "string",
      "pattern": "^(?:task|session|run|release|artifact)_[A-Za-z0-9_-]+$"
    },
    "result": {"enum": ["passed", "failed", "blocked", "unknown", "observed"]},
    "artifact_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "metadata": {"type": "object"},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
