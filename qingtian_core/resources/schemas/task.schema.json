{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qingtian-ai:schema:task:v1",
  "title": "Qingtian Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "project_id", "title", "objective", "scope", "acceptance", "state", "revision"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^task_[A-Za-z0-9_-]+$"},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "state": {"enum": ["DRAFT", "READY", "RUNNING", "BLOCKED", "REVIEW_PENDING", "DONE", "CANCELLED"]},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
