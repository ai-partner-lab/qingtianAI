#!/bin/sh
set -eu
PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$PROJECT_ROOT/.venv/bin/python" ]; then
  QINGTIAN_PYTHON="$PROJECT_ROOT/.venv/bin/python"
else
  QINGTIAN_PYTHON=python3
fi
PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$QINGTIAN_PYTHON" -m qingtian_engine "$@"
