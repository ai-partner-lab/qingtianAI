include LICENSE
include NOTICE
include README.md
include CONTRIBUTING.md
include SECURITY.md
include CHANGELOG.md
include pyproject.toml
include MANIFEST.in
include qingtian
include qingtian-kb
include release-allowlist.json
include .gitattributes
include .gitignore
recursive-include .github *.yml
recursive-include qingtian_core *.py *.json
recursive-include qingtian_engine *.py *.json *.html *.css *.js
# Include repository CI tooling for tests run from an unpacked source distribution.
recursive-include scripts *.py *.sh
recursive-include qingtian_core/resources/demo *.html *.css *.js
recursive-include qingtian_kb *.py *.json *.md *.txt
recursive-include tests *.py
include tests/atlas/fixtures/schema10.sql
recursive-include docs *.md
recursive-include docs *.excalidraw
recursive-include docs *.png
recursive-include docs *.svg *.json *.py
# Editorial showcase assets are an exact, reviewed exception, not a media glob.
prune docs/assets
include docs/assets/showcase/actual-board-public.png
include docs/assets/showcase/poster.png
include docs/assets/showcase/qingtian-showcase-short.mp4
recursive-include contracts *.json *.md
recursive-include config *.json *.md
recursive-include examples *.json
prune examples/showcase
include examples/showcase/README.md
include examples/showcase/scenario.json
include examples/showcase/engine_bridge.py
include examples/showcase/record.cjs
include examples/showcase/verify_recording.py
include examples/showcase/render.cjs
include examples/showcase/qa_media.cjs
include examples/showcase/check_playback.cjs
recursive-include schemas *.json
prune vault
prune .state
prune source-archive
prune receipts
prune checkpoints
prune runtime-data
prune .data
prune release
prune .venv
prune venv
prune build
prune dist
prune .git
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
prune .tox
prune .nox
prune output
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.egg-info
global-exclude *.local.json *.pid *.sqlite3 *.sqlite3-wal *.sqlite3-shm *.db *.db-wal *.db-shm
global-exclude .DS_Store
exclude config/sources.json
exclude config/*.local.json
